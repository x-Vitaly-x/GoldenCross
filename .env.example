# Trading212 — generate at: Trading212 app → Settings → API (Beta)
T212_API_KEY=your_trading212_api_key_here
T212_SECRET_KEY=your_trading212_secret_key_here
# Use "demo" for paper trading, "live" for real money (Phase 2 only)
T212_MODE=demo

# Together.ai — generate at: api.together.ai
TOGETHER_API_KEY=your_together_api_key_here
# Any chat model from together.ai/models
AI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Fraction of free cash to deploy per BUY signal (0.95 = 95%, keeps a small buffer)
POSITION_FRACTION=0.95

# Dashboard — pick any long random string, e.g.: openssl rand -hex 24
DASHBOARD_TOKEN=change_me_to_a_long_random_secret
